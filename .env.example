EHOS_ENVIRONMENT=development
EHOS_DEBUG=true
EHOS_PROJECT_NAME=EHOS Backend API

EHOS_DATABASE_URL=postgresql+asyncpg://ehos:ehos@localhost:5432/ehos
EHOS_REDIS_URL=redis://localhost:6379/0

EHOS_JWT_SECRET_KEY=change-me-in-production
EHOS_JWT_ACCESS_EXPIRE_MINUTES=15
EHOS_JWT_REFRESH_EXPIRE_DAYS=30
EHOS_JWT_ALGORITHM=HS256

EHOS_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

EHOS_MINIO_ENDPOINT=localhost:9000
EHOS_MINIO_ACCESS_KEY=ehos
EHOS_MINIO_SECRET_KEY=change-me
EHOS_MINIO_BUCKET=ehos-media
EHOS_MINIO_SECURE=false
EHOS_SEED_DATA_DIR=../crm
